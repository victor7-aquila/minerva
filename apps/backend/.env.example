# Backend 환경 변수
# 값은 비워 둔다. 실제 값은 .env에 쓰며 .env는 커밋하지 않는다.
# 키 정의와 검증 규칙은 src/common/MODULE.md 「설정」이 소유한다.
# 상대 경로는 apps/backend 폴더 기준이다.

# ── 서버 ────────────────────────────────────────────────

# 듣는 포트. 기본 3000
PORT=

# ── 저장소 (필수) ───────────────────────────────────────

# MongoDB 연결 문자열 (비밀). 경로에 DB 이름을 넣는다 (예: mongodb://localhost:27017/minerva)
MONGODB_URI=
# 이미지 파일 저장 위치. 기본 ../../data/backend/files
FILE_STORAGE_DIR=

# ── RAG Server 연동 (필수) ──────────────────────────────

# RAG Server 주소 (URL)
RAG_SERVER_URL=
# RAG Server에 보내는 요청의 X-Minerva-Token 값 (비밀). RAG Server의 RAG_API_TOKEN과 같은 값
RAG_SERVER_API_TOKEN=
# RAG Server가 보내는 알림의 토큰 (비밀). RAG Server의 RAG_BACKEND_EVENTS_TOKEN과 같은 값
RAG_EVENTS_TOKEN=

# ── RAG Server 호출 ─────────────────────────────────────

# 호출 시간 제한 (밀리초). 기본 30000
RAG_TIMEOUT_MS=
# 요약·캡션 생성 호출 시간 제한 (밀리초). 기본 120000
RAG_CAPTION_TIMEOUT_MS=
# 문서 삭제·이름·판 정보 변경 호출 시간 제한 (밀리초). 색인 중인 작업이 끝날 때까지 응답이 늦어진다. 기본 600000
RAG_WAIT_TIMEOUT_MS=
# 색인 요청의 청킹 방식 (semantic 또는 rule). 기본 semantic
CHUNKING_MODE=
# 처리 중인 문서의 색인 상태를 맞추는 주기 (밀리초). 기본 60000
RECONCILE_INTERVAL_MS=
# 실패한 청크 삭제·이름·판 정보 변경을 다시 요청하는 주기 (밀리초). 기본 60000
RAG_RETRY_INTERVAL_MS=

# ── 업로드 한도 ─────────────────────────────────────────

# MD 파일 하나의 최대 크기 (바이트). 기본 10485760 (10MB)
UPLOAD_MAX_MD_BYTES=
# 이미지 파일 하나의 최대 크기 (바이트). 기본 20971520 (20MB)
UPLOAD_MAX_IMAGE_BYTES=
# 요청 하나의 최대 파일 수. 기본 200
UPLOAD_MAX_FILES=
# 요청 하나의 최대 전체 크기 (바이트). 기본 209715200 (200MB)
UPLOAD_MAX_TOTAL_BYTES=

# ── 로그 ────────────────────────────────────────────────

# 문서 기록 보관 기간 (일). 기본 90
LOG_RETENTION_DAYS=
