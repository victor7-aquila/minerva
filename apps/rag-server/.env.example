# RAG Server 환경 변수
# 값은 비워 둔다. 실제 값은 .env에 쓰며 .env는 커밋하지 않는다.
# 키 정의와 검증 규칙은 src/minerva_rag/core/MODULE.md 「설정」이 소유한다.
# 상대 경로는 apps/rag-server 폴더 기준이다.

# ── 연결 (필수) ─────────────────────────────────────────

# Qdrant 주소 (URL)
RAG_QDRANT_URL=
# Ollama 주소 (URL)
RAG_OLLAMA_URL=
# Backend의 작업 상태 알림 받는 주소 (URL, POST /v1/internal/rag-events)
RAG_BACKEND_EVENTS_URL=

# ── 인증 (필수, 비밀) ───────────────────────────────────

# 알림에 담는 토큰. Backend의 알림 토큰과 같은 값
RAG_BACKEND_EVENTS_TOKEN=
# Backend가 요청 헤더 X-Minerva-Token에 담아야 하는 토큰. Backend의 RAG Server API 토큰과 같은 값
RAG_API_TOKEN=

# ── 요청 크기 한도 ──────────────────────────────────────

# 색인 요청 markdown의 최대 크기 (바이트, UTF-8). 기본 10485760 (10MB)
RAG_MAX_MARKDOWN_BYTES=
# 이미지 캡션 요청 image의 최대 크기 (바이트). 기본 20971520 (20MB)
RAG_MAX_IMAGE_BYTES=

# ── 로컬 파일 ──────────────────────────────────────────

# 작업 목록 SQLite 파일. 기본 ../../data/rag-server/jobs.sqlite3
RAG_JOBS_DB_PATH=
# 임베딩·재정렬 모델 파일 위치. 미리 받아 두면 기동할 때 내려받지 않는다. 기본 ../../data/rag-server/models
RAG_MODELS_DIR=
# 용어집 파일. 기본 config/glossary.yaml
RAG_GLOSSARY_PATH=

# ── 모델 ────────────────────────────────────────────────

# 청킹 LLM (Ollama 모델 이름). 기본 qwen3:14b
RAG_CHUNKING_LLM=
# 표 요약 LLM (Ollama 모델 이름). 기본 qwen3:14b
RAG_TABLE_LLM=
# 이미지 캡션 VLM (Ollama 모델 이름). 기본 qwen3-vl:8b
RAG_CAPTION_VLM=
# 임베딩 모델 (sentence-transformers 이름). 바꾸면 강제 재색인이 필요하다. 기본 Qwen/Qwen3-Embedding-4B
RAG_EMBEDDING_MODEL=
# 재정렬 모델 (sentence-transformers 이름). 기본 BAAI/bge-reranker-v2-m3
RAG_RERANKER_MODEL=
# Ollama 생성 요청마다 지정하는 컨텍스트 크기 (토큰). 기본 16384
RAG_LLM_CONTEXT_TOKENS=
# 컨텍스트 중 출력에 남기는 몫 (토큰). 기본 4096
RAG_LLM_OUTPUT_RESERVE_TOKENS=

# ── 청킹 ────────────────────────────────────────────────

# 청크 크기 상한 (토큰, 임베딩 모델 토크나이저 기준). 기본 512
RAG_CHUNK_MAX_TOKENS=
# 분할 LLM 한 번에 보내는 입력 한도 (토큰). 출력 몫과 합해 컨텍스트 크기 이하. 기본 8000
RAG_CHUNKING_LLM_MAX_INPUT_TOKENS=
# 자리표시 검증 실패 시 의미 단위 분할을 다시 시도하는 횟수. 기본 2
RAG_CHUNKING_RETRIES=

# ── 검색 ────────────────────────────────────────────────

# 결과 개수 N을 주지 않았을 때의 기본 개수. 기본 10
RAG_SEARCH_DEFAULT_TOP_N=
# 결과 하나에 넣는 앞뒤 청크의 합계 상한 (토큰). 기본 1024
RAG_NEIGHBOR_MAX_TOKENS=
# 최신판 결과의 점수에 더하는 가중치. 기본 0
RAG_LATEST_EDITION_WEIGHT=

# ── 작업 ────────────────────────────────────────────────

# 동시에 처리하는 색인 작업 수. 기본 1
RAG_JOB_CONCURRENCY=
# 알림을 보내지 못했을 때 다시 보내는 횟수 (1초에서 시작해 두 배씩). 기본 5
RAG_NOTIFY_RETRIES=
# 종료할 때 색인 중인 작업을 기다리는 시간 (초). 기본 30
RAG_SHUTDOWN_TIMEOUT_SECONDS=
